# Image backend khusus GPU (NVIDIA CUDA 12.4 + PyTorch 2.4+)
# Sangat direkomendasikan untuk GPU generasi baru seperti RTX 5060 Ti / Blackwell
FROM pytorch/pytorch:2.4.0-cuda12.4-cudnn9-runtime

# Install ffmpeg untuk konversi audio WAV 16kHz
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install requirements aplikasi (FastAPI, SQLAlchemy, Transformers, dll)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
