# ==============================================================================
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# File .env TIDAK boleh di-commit (sudah ada di .gitignore).
# ==============================================================================

# --- PostgreSQL (service `db` di docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rme_stt

# --- Backend FastAPI ---
# Untuk menjalankan lewat docker compose, nilai DATABASE_URL akan di-override
# otomatis oleh compose (host `db`). Nilai di bawah dipakai untuk mode
# non-Docker (backend dijalankan langsung di mesin/host).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rme_stt
SECRET_KEY=CHANGE_ME_pakai_string_acak_panjang
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
# mock | real  (lihat Bagian 6 rancangan; `real` aktif setelah model NLP siap)
NLP_ENGINE=mock
MAX_UPLOAD_MB=50
COOKIE_SECURE=false

# --- Frontend (opsional; default sudah benar untuk mode lokal) ---
# Target proxy Vite untuk path /api (dev server frontend -> backend)
VITE_API_PROXY_TARGET=http://localhost:8000
